# okx-register / trade 配置模板 —— 复制为 .env 后按需修改。
# 工具会读 .env（当前目录优先，其次项目根）；真实环境变量优先于 .env，命令行参数又优先于两者。
# .env 已在 .gitignore 中（不会入库），本文件是模板，可安全入库。
#
# 下面的每一项都等价于一个命令行参数；想用哪项就去掉行首的 #。


  # devid：默认用会话里抓到的（服务端把会话和设备绑了，乱换会让 DEX 报价返回空路由）
# 想固定设 DEVID=<uuid>；想强制随机设 RANDOM_DEVID=1（可能拿不到报价）
# RANDOM_DEVID=false
# DEVID=

# ───────────────────────── 交易（bin/trade.js，一买一卖） ─────────────────────────
# 计价币（钱，--quote）：默认 USDT（Base）；Base 的 USDC 是 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# QUOTE_TOKEN=0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2
# 交易币（来回买卖，--trade）：默认 XDP（Base）
# TRADE_TOKEN=0x07b3d902783c3c12b077508c3b5c00113d1291d0
# 每个钱包每轮投入多少计价币（--amount，人类可读；all = 全余额）
# AMOUNT=1
# 同一钱包来回几轮（--loop）
# LOOP=1
# 原子来回：买/卖 calldata 备好，nonce=N/N+1 背靠背广播（--fast）
# FAST=false

# 链 id（--chain，默认 8453 = Base；56 = BSC）
# CHAIN_ID=8453
# 买腿固定滑点（--slippage，如 0.01 = 1%；留空 = 后端自动）
# SLIPPAGE=0.01
# 卖腿滑点阶梯起点（--slippage-exit；留空 = 跟随 SLIPPAGE；都没设 = 自动）
# SLIPPAGE_EXIT=
# 报价滑点闸门（--max-slippage；超过就重新报价，0 = 不限制）
# 注意:XDP 后端默认滑点 5%，闸门要 > 0.05，否则每单都被拦
# MAX_SLIPPAGE=0.06
# 报价价差闸门（--max-value-diff；|diffPercent| 超过就重新报价，0 = 不限制）
# MAX_VALUE_DIFF=0.01
# 闸门连续超限前的重新报价次数（--slippage-retries）
# GATE_RETRIES=3
# 接口瞬时错误重试次数（--api-retries）
# API_TRIES=3
# 买腿失败重试次数（--buy-retries）
# BUY_RETRIES=3
# 卖腿补卖次数（--sell-retries）
# SELL_RETRIES=3
# 授权不足也不补授权（--no-approve）
# NO_APPROVE=false
# 不做残留清扫（--no-sweep）
# NO_SWEEP=false
# 残留低于这个数量（交易币单位）就不扫（--sweep-min；0 = 全部扫）
# SWEEP_MIN_TOKEN=0
# 前置闸门：BNB 低于这个数就跳过该钱包（--min-gas）
# MIN_GAS_BNB=0.0002
# 关掉前置闸门（--no-precheck）
# NO_PRECHECK=false

# 只做一次性无限授权（--approve-only）
# APPROVE_ONLY=false
# 只清残留（--sweep-only）
# SWEEP_ONLY=false
# approve-only 的币，逗号分隔（--token，别名 usdt/bank 或地址）；留空 = quote,trade
# APPROVE_TOKEN=

# 私钥文件路径（--keys，默认 当前目录/key.env）
# KEYS_FILE=key.env
# Solana 私钥文件（--sol-keys，本工具不用，保留兼容）
# SOL_KEYS_FILE=
# 只交易这些地址，逗号分隔（--wallets）
# WALLETS=0xabc...,0xdef...
# 处理第几把到第几把，1 起含两端；TO_INDEX=0 表示到最后（--from / --to）
# FROM_INDEX=1
# TO_INDEX=0
# 最多处理 n 把（--limit）
# LIMIT=0

# 普通 RPC（--rpc；可逗号分隔多个。启动时对每个节点测「延迟 + 回执能力」，只快但取不到
# 回执的会被自动排除；选中的节点报错时自动轮换到池里其它节点。留空 = 用该链内置 RPC 池）
# RPC_URL=
# 广播兜底 RPC（--broadcast-rpc；优先用报价里的 BlockRazor 中继）
# BROADCAST_RPC_URL=
# 回执轮询：总预算 = RECEIPT_TRIES x RECEIPT_INTERVAL_MS（默认 30 x 2s = 60s）
# Base 出块约 2s，间隔别调得比这大太多
# RECEIPT_TRIES=30
# RECEIPT_INTERVAL_MS=2000
# 单次 JSON-RPC 超时与重试（重试会在主节点/备用节点之间轮换）
# RPC_TIMEOUT_MS=20000
# RPC_RETRIES=3
# 报价用 accountId（--account-id；留空随机生成）
# ACCOUNT_ID=
# referralCode（--refcode，默认 11OKB）
# COMPETITION_REFERRAL=11OKB
# 两个钱包/两轮开始之间的最小间隔，秒（--interval，默认 1.2）
# INTERVAL=1.2

# ── 并发（--concurrency；并发单位 = 钱包，不同地址 nonce 独立）──
# 同时跑几个钱包（默认 1 = 严格串行；上限 8）
# CONCURRENCY=1
# 并发时 = 两次「启动」之间的间隔秒；auto = 按历史单钱包耗时 ÷ 并发数自动算
# SLEEP=
# 全局接口闸门：整个进程发往 OKX 的请求间隔下限（毫秒），仅并发时生效
# API_GATE_MS=350
# 进度文件（按地址记录，断点续跑）。配 --status / --reset / --retry-ok / --no-resume
# STATE=
# 报告目录（--report-dir，默认 reports；每次生成 trade-<时间>.csv/.json/.html + trade-latest.html）
# REPORT_DIR=reports

# 磨损上报：交易跑完把每个钱包真实成本 POST 到数据台，按地址累计入库
# （数据台 xdp.php 的「我的钱包批量查询」会显示累计真实磨损）
# COST_INGEST_URL=https://boost.6117.com.cn/xdp/xdp.php
# COST_INGEST_TOKEN=改成和 xdp.php 里 COST_INGEST_TOKEN 一样
# 本次不上报
# NO_PUSH=true
# 会话文件（--session，默认 creds/web3-session.json）
# SESSION_FILE=

# ⚠️ 执行开关：仅 true / 1 / yes / on 视为开启；默认全部关闭（干跑）
# 真签真发（--execute）
# EXECUTE=false
# 真发的二次确认（--yes）
# YES=false
# 不写报告（--no-report）
# NO_REPORT=false
