# ============================================================================
# okx-xdp-crawler 配置模板 —— 复制为 .env 后按需修改
#   cp .env.example .env
#   .env 含 OKX 密钥与数据库密码，已在 .gitignore 中，禁止提交
# ============================================================================

# ---------- 目标（Base 链上的 XDP / Doppler Finance）----------
# Base = 8453，BSC = 56，Ethereum = 1
CHAIN_INDEX=8453
TOKEN_ADDRESS=0x07b3d902783c3c12b077508c3b5c00113d1291d0
TOKEN_SYMBOL=XDP

# ---------- OKX DEX API（HMAC 签名，去 okx.com 申请）----------
OKX_API_KEY=your-okx-api-key
OKX_SECRET_KEY=your-okx-secret-key
OKX_PASSPHRASE=your-okx-passphrase

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=okx
DB_PASSWORD=change-me

# 成交 WebSocket（免费实时，不需要 key）
# WS_TRADES_ENABLED=1
# WS_TRADES_URL=wss://wsdexpri.okx.com/ws/v5/ipublic
# WS_TRADES_CHANNEL=dex-market-trade-history-pub
# WS 顶上后 REST 实时轮询默认关闭（省每月 100K 免费额度）
# REST_REALTIME_ENABLED=0
# 周期性链上重扫（免费兜底）：捡回停机期间 / WS 漏推的成交
# ONCHAIN_RESCAN_ENABLED=1
# ONCHAIN_RESCAN_MINUTES=20
# CRON_ONCHAIN_RESCAN=*/10 * * * *
DB_NAME=okx_xdp

# ---------- 实时增量 ----------
LIMIT=100
MAX_PAGES_REALTIME=2
# 出块监听会即时触发抓取，这里只是兜底，2~5 秒足够
CRON_REALTIME=*/2 * * * * *

# ---------- 链上实时通道（出块即触发 + 直采）----------
# 订阅 Base 新区块；一旦块里有「打到 OKX 路由」的交易就立刻触发抓取 + 刷新排行
WATCHER_ENABLED=1
CHAIN_WSS_URL=wss://base-rpc.publicnode.com
# WSS 不可用时退回 HTTP 轮询的间隔
WATCHER_POLL_MS=2000
# 并发取回执 / 解析的并行度
WATCHER_CONCURRENCY=4
# 1 = 同时做「链上直采」（自己解析 Transfer 日志入库，不等 OKX 索引；USDC/USDT/USDbC 计价）
WATCHER_INGEST=1
# 启动时回看几个块，避免重启瞬间漏单
WATCHER_BACKFILL_BLOCKS=3

# ---------- 周期性增量回溯（捡回接口"晚索引"的成交）----------
# OKX trades 接口对新交易有索引延迟：刚上链的成交可能几分钟后才返回。
# 一次性回溯完成后不再重扫 → 这些成交会永久丢（实测命中率 84% → 99% 的差距来源）。
CRON_RECHECK=*/10 * * * *
RECHECK_MINUTES=120
RECHECK_MAX_PAGES=30
# 连续几次空页才认定"翻到头"（1 次空页 = 可能只是接口没索引好）
BACKFILL_EMPTY_CONFIRM=3

# ---------- 历史回溯 ----------
LIMIT_BACKFILL=100
MAX_PAGES_BACKFILL=10
CRON_BACKFILL=*/20 * * * * *
# 回溯下界：早于该时间的交易不统计（毫秒时间戳或 ISO 字符串；留空 = 不限制）
# = 活动参与开始时间 2026-09-28 21:40（UTC+8）；等价毫秒 1790602800000
BACKFILL_STOP_TIME=2026-09-28T13:40:00Z

# ---------- 采集上界（活动结束保护）----------
# = 活动参与结束时间 2026-09-30 21:40（UTC+8）；等价毫秒 1790775600000
# 领奖时间是 2026-09-30 23:40 ~ 2026-10-14 23:40（UTC+8），跟采集无关
COLLECT_END_TIME=2026-09-30T13:40:00Z

# ---------- 统计窗口（排行榜口径）----------
# 留空 = 不限制。写法：ISO 字符串（UTC）
# 与上面两个时间一致：活动参与时间 2026-09-28 21:40 ~ 09-30 21:40（UTC+8）
CAMPAIGN_START_UTC=2026-09-28T13:40:00Z
CAMPAIGN_END_UTC=2026-09-30T13:40:00Z

# ---------- 有效币对 ----------
# 只有 XDP 与下列币种的交易对才计入排行；留空 = 所有币对都计入
# XDP 在 Base 上的主要交易对是 USDC 和 ETH
VALID_QUOTE_SYMBOLS=USDC,USDT,WETH,ETH,USDbC

# ---------- OKX 方法 ID（dagSwapTo，路由判定用）----------
OKX_METHOD_IDS=0x0c307f76

# ---------- 活动口径：是否只统计经 OKX DEX 路由的成交 ----------
# 1 = 只有 is_okx=1 的成交计入（口径最严，需要配置 OKX_ROUTERS）
# 0 = 所有成交都计入（默认；XDP 活动规则确认后再按需开启）
REQUIRE_OKX_ROUTE=1
# Base 上已实测到的 OKX DEX 路由（methodId = 0x0c307f76 dagSwapTo）；
# 可用 npm run scan:routers:discover 重新发现。
OKX_ROUTERS=0x67d03631fe51b741c0c00c4e16eb662ac84381df
# 入库时是否顺带判定路由（开了会多打 OKX Explorer 接口；REQUIRE_OKX_ROUTE=1 时自动开）
CLASSIFY_ROUTES_ON_SAVE=1

# ---------- 只看官方已报名钱包 ----------
# 官方榜 = 已报名 ∩ 有交易量（实测官方榜尾部有 $0.00 的钱包 → 没有交易量门槛，
# 没排上纯粹是「没报名」）。开 = 本地名次与官方对齐；关 = 统计所有 OKX 路由钱包。
# 名单由 scripts/poll-launchpool.js 每次采样写入 official_wallet 表。
# ONLY_OFFICIAL_WALLETS  # 已废弃：官方榜只给 top100，不再按官方名单过滤

# ---------- 入库过滤：只留「官方计分」的成交 ----------
# 1) 只留走 OKX 路由的（is_okx=1）；判不出来的留 NULL，交给 scan-routers 补判
INGEST_ONLY_OKX=1
# 2) 连「订单式成交」也丢：tx.to 都是同一个 OKX 路由，只差调用的函数
#    0x0c307f76 dagSwapTo        —— 普通兑换，官方活动认
#    0xf2c42696 dagSwapByOrderId —— 按订单号成交（订单式/做市 API），官方一封都不算，约占入库量一半
INGEST_DROP_ORDER_SWAP=1

# ---------- 黑名单（热更新，改完不用重启）----------
BLACKLIST_WALLETS=
BLACKLIST_RELOAD_MS=60000

# ---------- Base RPC（合约地址扫描 / 路由兜底扫描用）----------
CHAIN_RPC_URL=https://mainnet.base.org
RPC_CONCURRENCY=4
# 每个 JSON-RPC 批量请求塞多少个 eth_getCode（公共 RPC 单发会被 429 限流）
RPC_BATCH=10

# ---------- 合约地址检测 ----------
CRON_CONTRACTS=*/5 * * * *

# ---------- 路由判定兜底扫描 ----------
CRON_ROUTERS=*/20 * * * * *
ROUTER_USE_OKX_API=1
ROUTER_CHUNK=20
ROUTER_CONCURRENCY=3

# ---------- 排行榜物化刷新 ----------
CRON_RANK=*/10 * * * * *

# ---------- 官方榜单采样（可选）----------
# 填了 LAUNCHPOOL_ID 才会启用；排行榜页面本身实时读 MySQL，不依赖这里
LAUNCHPOOL_ID=792
CRON_POLL=0 * * * * *
EQUAL_POOL=10000000
VOLUME_POOL=10000000

